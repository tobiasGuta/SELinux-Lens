<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
    "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SELinux Lens</vendor>
  <action id="io.github.tobiasguta.SELinuxLens.read-recent-avcs">
    <description>Read a recent SELinux audit snapshot</description>
    <message>Administrator authentication is required to read recent SELinux audit denials</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
